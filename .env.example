# ===========================================================================
# sulfur-news 环境变量模板
#
# 使用方式：
#   cp .env.example .env
#   按需修改后启动后端
#
# 约定：
#   - 所有变量都可省略，config.py 中均有默认值
#   - 列表型变量使用英文逗号分隔，不要加空格
#   - 修改后重启服务即可生效（配置只在进程启动时读取一次）
# ===========================================================================

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 监听地址与端口
HOST=0.0.0.0
PORT=8000

# 是否开启 uvicorn 热重载（仅本地开发）
RELOAD=false

# CORS 允许来源，逗号分隔；生产环境请替换为具体域名
# 示例：https://sulfur.example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# 聚合
# ---------------------------------------------------------------------------
# 时间窗口（天）：只展示最近 N 天的新闻
NEWS_WINDOW_DAYS=15

# 后台刷新间隔（小时）：首次启动会立即刷新一次
REFRESH_INTERVAL_HOURS=4

# 单个 HTTP 请求超时（秒）
FETCH_TIMEOUT_SECONDS=20

# 单个源最多返回条数（防止某源一次返回上千条）
MAX_ITEMS_PER_SOURCE=100

# 并发抓取数（同时进行的 HTTP 请求上限）
REQUEST_CONCURRENCY=5

# ---------------------------------------------------------------------------
# GDELT
# ---------------------------------------------------------------------------
# GDELT DOC 2.0 API 地址，留空则禁用 GDELT 源
GDELT_API=https://api.gdeltproject.org/api/v2/doc/doc

# 检索式，支持 GDELT 语法：
#   - 布尔：AND / OR / NOT
#   - 引号：精确短语 "sulfur price"
#   - 括号：组合条件
#   - 字段：domain:reuters.com sourcelang:english
GDELT_QUERY=(硫磺 OR sulfur OR sulphur)

# 单次最多返回条数（GDELT 上限 250）
GDELT_MAX_RECORDS=100

# 语言过滤，留空=不限
# 可选值：english, chinese, spanish, ... （GDELT 全小写）
GDELT_LANGUAGE=

# 来源国家过滤，留空=不限
# 可选值：US, CH, UK, ... （ISO 3166-1 alpha-2 大写）
GDELT_SOURCE_COUNTRY=

# ---------------------------------------------------------------------------
# RSS
# ---------------------------------------------------------------------------
# RSS / Atom 源列表，逗号分隔，留空则只跑 GDELT
#
# 建议采集的硫磺相关源（示例，按需启用）：
#   - 中化新网：        https://www.ccin.com.cn/rss.xml
#   - 生意社化工：      http://www.100ppi.com/rss/hg.xml
#   - 我的钢铁：        https://news.mysteel.com/rss.xml
#   - 隆众资讯：        https://www.oilchem.net/rss.xml
#
# 注意：部分站点对 UA、频率敏感，如被封可在 sources/rss.py 里调整 UA
RSS_FEEDS=

# ---------------------------------------------------------------------------
# 前端（一般不用改）
# ---------------------------------------------------------------------------
# 前端静态目录；相对路径以项目根为基准
# 默认 ../frontend，即 sulfur-news/frontend
# FRONTEND_DIR=../frontend
